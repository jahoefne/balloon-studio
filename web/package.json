{
  "name": "balloon-studio",
  "version": "1.29.3",
  "private": true,
  "type": "module",
  "imports": {
    "#core": {
      "balloon-core-real": "./src/core/real/index.ts",
      "default": "./src/core/stub/index.ts"
    },
    "#core/parameters": {
      "balloon-core-real": "./src/core/real/parameters.ts",
      "default": "./src/core/stub/parameters.ts"
    }
  },
  "license": "MIT",
  "description": "Parametric balloons, baskets, mobile rings, hanging figures, cloud and sun lamps and cable clips for 3D printing. Configure and download print files in the browser.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:full": "FULL=1 vitest run",
    "test:reference": "vitest run --config vitest.reference.config.ts",
    "test:smoke": "VITE_CORE=real REFS_SMOKE=1 vitest run --config vitest.reference.config.ts",
    "census": "node scripts/assertion-census.ts",
    "size": "node scripts/check-bundle-size.mjs",
    "lint": "eslint src/core",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "bench": "vite build --config bench/vite.config.ts --logLevel warn && node node_modules/.bench/budgets.js"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@stdlib/math-base-special-acos": "^0.2.4",
    "@stdlib/math-base-special-asin": "^0.2.4",
    "@stdlib/math-base-special-atan": "^0.2.4",
    "@stdlib/math-base-special-atan2": "^0.3.1",
    "@stdlib/math-base-special-cbrt": "^0.2.3",
    "@stdlib/math-base-special-cos": "^0.3.1",
    "@stdlib/math-base-special-exp": "^0.2.5",
    "@stdlib/math-base-special-ln": "^0.2.5",
    "@stdlib/math-base-special-pow": "^0.3.1",
    "@stdlib/math-base-special-sin": "^0.3.1",
    "@stdlib/math-base-special-tan": "^0.3.1",
    "lucide-react": "1.57.0",
    "opentype.js": "^2.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.186.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
